# Force an institution code (sent as X-Tenant). Leave empty to resolve by host name.
VITE_TENANT=
# API origin when not served behind the same host (e.g. https://api.example.ac.tz). Empty = same origin.
VITE_API_BASE=
# Show development helpers (e.g. "Simulate payment") in a production build. Never enable on a live site.
VITE_SHOW_DEV_TOOLS=false
