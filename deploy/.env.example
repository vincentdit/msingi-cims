# CIMS production settings. Copy to deploy/.env (never commit it), fill in every CHANGE value, keep a copy in the
# password manager. Values here reach the backend as environment variables (docker-compose.prod.yml, env_file).

# ---- images
CIMS_IMAGE_PREFIX=msingi
CIMS_VERSION=latest

# ---- database
POSTGRES_SUPERUSER_PASSWORD=CHANGE-long-random
CIMS_DB_PASSWORD=CHANGE-long-random
CIMS_DB_POOL=30                     # 10 on a small pilot server (docker-compose.memory.yml)

# ---- security (NFR-SEC-01/03)
# 32 random bytes, base64:  openssl rand -base64 32
CIMS_DATA_KEY=CHANGE
# RS256 key pair for CIMS's own sign-in tokens, PEM bodies on one line (see README "Sign-in keys")
CIMS_JWT_PRIVATE_KEY=CHANGE
CIMS_JWT_PUBLIC_KEY=CHANGE
CIMS_JWT_ISSUER=https://cims.ac.tz
CIMS_ACCESS_TOKEN_TTL=60m
CIMS_CORS_ORIGINS=https://*.cims.ac.tz
CIMS_PLATFORM_BOOTSTRAP_USERNAME=msingi
CIMS_PLATFORM_BOOTSTRAP_PASSWORD=CHANGE-first-sign-in-only

# ---- links in letters, SMS and email ({host} is the institution's domain)
CIMS_VERIFICATION_URL=https://{host}/verify/{code}
CIMS_PORTAL_URL=https://{host}

# ---- SMS and email
# simulated = messages written to the log; live = sent through the SMS provider (NextSMS or Beem) set in the Msingi console
# (Console > SMS). Set the provider up and test it there first, then switch to live and restart.
CIMS_SMS_MODE=simulated
# The platform address the SMS provider posts delivery reports to (the console shows the full address to give the provider)
CIMS_SMS_CALLBACK_BASE_URL=https://app.cims.ac.tz
# Testing a pilot server before an SMS provider is chosen: show the sign-up code on screen. CIMS refuses to start with it
# once CIMS_SMS_MODE is live. Set it back to false before real applicants register.
CIMS_OTP_SHOW_ON_SCREEN=false
CIMS_SMS_CALLBACK_SECRET=CHANGE
CIMS_EMAIL_MODE=simulated              # smtp once an SMTP account exists (then fill in the CIMS_SMTP_* values)
CIMS_EMAIL_FROM=no-reply@cims.ac.tz
CIMS_SMTP_HOST=smtp.example.com
CIMS_SMTP_PORT=587
CIMS_SMTP_AUTH=true
CIMS_SMTP_STARTTLS=true
CIMS_SMTP_SSL=false                    # true only for port 465 (then CIMS_SMTP_STARTTLS=false)
CIMS_SMTP_USERNAME=CHANGE
CIMS_SMTP_PASSWORD=CHANGE

# ---- NECTA and NACTVET (keys from NECTA / NACTVET; never commit them)
CIMS_NECTA_MODE=live
NECTA_API_KEY=CHANGE
CIMS_NACTVET_AWARDS_MODE=live
NACTE_AUTHORIZATION=CHANGE
NACTE_API_CODE=CHANGE
# NACTVET's catalogue of institutions and programmes (platform console); same credentials as the awards service
CIMS_NACTVET_CATALOGUE_MODE=live
# Address to use for www.nacte.go.tz when the server's DNS answer is unreachable (the pilot server needed 41.93.76.6);
# the host name and its TLS certificate are still checked. Leave empty when ordinary lookups work.
NACTE_PREFER_IP=
# Admission verification, student registration and results by API: switch to live once NACTVET publishes the services
CIMS_NACTVET_MODE=simulated
CIMS_NACTVET_SUBMISSION_MODE=simulated

# ---- GePG (public institutions). Keys in deploy/secrets (README "GePG on-boarding").
# Simulated until GePG on-boarding is done. Fill in the four key settings only when the files are in deploy/secrets; with
# live mode, CIMS will not start without them. In simulated mode, paths to missing files are ignored with a warning.
CIMS_GEPG_MODE=simulated
CIMS_GEPG_URL=https://uat1.gepg.go.tz
CIMS_GEPG_KEYSTORE=
CIMS_GEPG_KEYSTORE_PASSWORD=
CIMS_GEPG_KEY_ALIAS=
CIMS_GEPG_CERTIFICATE=
# e.g. CIMS_GEPG_KEYSTORE=/run/secrets/cims/gepg-sp.p12 and CIMS_GEPG_CERTIFICATE=/run/secrets/cims/gepg-public.crt
CIMS_GEPG_CALLBACK_SECRET=CHANGE

# ---- private and faith-based institutions' own collection accounts
CIMS_COLLECTION_MODE=statement
# Rehearsal only: "Simulate payment" buttons mark fees as paid without money. Off in production unless set to true here;
# CIMS warns at every start-up while it is on. Remove it (or set false) before real payments.
CIMS_ALLOW_PAYMENT_SIMULATION=false
CIMS_COLLECTION_CALLBACK_SECRET=CHANGE

# ---- optional exchanges: each institution switches them on under Integrations
CIMS_HESLB_MODE=simulated
CIMS_HESLB_URL=https://olas.heslb.go.tz
CIMS_HESLB_API_KEY=
CIMS_NIDA_MODE=simulated
CIMS_NIDA_URL=https://services.nida.go.tz
CIMS_NIDA_API_KEY=
CIMS_MUSE_MODE=simulated
CIMS_MUSE_URL=https://muse.mof.go.tz
CIMS_MUSE_API_KEY=
CIMS_TAMISEMI_MODE=simulated
CIMS_TAMISEMI_URL=https://selform.tamisemi.go.tz
CIMS_TAMISEMI_API_KEY=
# NHIF Student Registration API: each institution's agent credentials go in Integrations › NHIF (not here);
# give NHIF the callback and token addresses shown there
CIMS_NHIF_MODE=simulated
CIMS_NHIF_URL=https://student.nhif.or.tz

# ---- backups (NFR-AVL-03): daily at 01:15 EAT, 35 daily and 12 monthly kept; passphrase in deploy/secrets/backup-passphrase
BACKUP_CRON=15 1 * * *
BACKUP_DAILY_KEEP_DAYS=35                # 14 on a small server's disk: the full history stays at the second location
BACKUP_MONTHLY_KEEP_MONTHS=12
# Command that copies /backups to the second location, run after each backup and each WAL shipment. The backup image has
# rclone and ssh; put rclone's configuration in deploy/secrets/rclone.conf (or an SSH key in deploy/secrets/), e.g.
#   rclone copy /backups offsite:cims-backups --max-age 48h
#   rsync -a -e "ssh -i /run/secrets/cims/backup_ed25519 -o StrictHostKeyChecking=accept-new" /backups/ backup@host:cims/
BACKUP_OFFSITE_CMD=                      # set by scripts/offsite-setup.sh (e.g. rclone sync /backups offsite:cims-backups)

# Server watch (scripts/cims-watch.sh install): alerts by email through the CIMS mailbox above
CIMS_ALERT_EMAIL=                       # one or more addresses, comma-separated
CIMS_WATCH_URL=https://app.cims.ac.tz
CIMS_SMS_LOW_BALANCE_ALERT=5000         # email Msingi staff when the SMS provider account falls below this many SMS
